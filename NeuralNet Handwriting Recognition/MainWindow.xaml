<Window x:Class="NeuralNet_Handwriting_Recognition.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:NeuralNet_Handwriting_Recognition"
        mc:Ignorable="d"
        Title="Handwriting Recognition" Height="570" Width="509.069" Closing="Window_Closing">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="auto"></RowDefinition>
            <RowDefinition Height="auto"></RowDefinition>
            <RowDefinition Height="auto"></RowDefinition>
            <RowDefinition></RowDefinition>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="auto"></ColumnDefinition>
            <ColumnDefinition></ColumnDefinition>
        </Grid.ColumnDefinitions>
        <Menu Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2">
            <MenuItem Header="File">
                <MenuItem Header="Load from File" Name="MnuLoad" Click="MnuLoad_Click"></MenuItem>
                <MenuItem Header="Save to File" Name="MnuSave" Click="MnuSave_Click"></MenuItem>
                <Separator></Separator>
                <MenuItem Header="Exit" Name="MnuExit" Click="MnuExit_Click"></MenuItem>
            </MenuItem>
            <MenuItem Header="Data" IsEnabled="False" Name="MnuData" >
                <MenuItem Header="Select Training Data" Name="MnuSelectTrainData" Click="MnuSelectTrainData_Click" ></MenuItem>
                <MenuItem Header="Select Test Data" Name="MnuSelectTestData" Click="MnuSelectTestData_Click"></MenuItem>
            </MenuItem>
        </Menu>
        <GroupBox Grid.Row="1" Grid.Column="0" Margin="5" Header="Define Neural Net:" BorderBrush="Blue" BorderThickness="1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="auto"></RowDefinition>
                    <RowDefinition Height="auto"></RowDefinition>
                    <RowDefinition Height="auto"></RowDefinition>
                    <RowDefinition Height="auto"></RowDefinition>
                    <RowDefinition Height="auto"></RowDefinition>
                    <RowDefinition></RowDefinition>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition></ColumnDefinition>
                    <ColumnDefinition></ColumnDefinition>
                </Grid.ColumnDefinitions>
                <Label Grid.Row="0" Grid.Column="0" Margin="3">Input Nodes:</Label>
                <TextBox Grid.Row="0" Grid.Column="1" Margin="3" Name="TxtInputNodes" HorizontalAlignment="Left" VerticalAlignment="Center" Width="50">784</TextBox>
                <Label Grid.Row="1" Grid.Column="0" Margin="3">Hidden Nodes:</Label>
                <TextBox Grid.Row="1" Grid.Column="1" Margin="3" Name="TxtHiddenNodes" HorizontalAlignment="Left" VerticalAlignment="Center" Width="50">100</TextBox>
                <Label Grid.Row="2" Grid.Column="0" Margin="3">Output Nodes:</Label>
                <TextBox Grid.Row="2" Grid.Column="1" Margin="3" Name="TxtOutputNodes" HorizontalAlignment="Left" VerticalAlignment="Center" Width="50">10</TextBox>
                <Label Grid.Row="3" Grid.Column="0" Margin="3">Learning rate:</Label>
                <TextBox Grid.Row="3" Grid.Column="1" Margin="3" Name="TxtLearningRate" HorizontalAlignment="Left" VerticalAlignment="Center" Width="50">0.1</TextBox>
                <CheckBox Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="2" Margin="8" Name="CBNormalize">Normalize Weights</CheckBox>
                <Button Grid.Row="5" Grid.Column="0" Grid.ColumnSpan="2" Margin="5" Width="80" Name="BtnCreate" Click="BtnCreate_Click">CREATE</Button>
            </Grid>
        </GroupBox>
        <GroupBox Grid.Row="2" Grid.Column="0" Margin="5" Header="Train Neural Net:" BorderBrush="Blue" BorderThickness="1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="auto"></RowDefinition>
                    <RowDefinition Height="auto"></RowDefinition>
                    <RowDefinition Height="auto"></RowDefinition>
                    <RowDefinition Height="auto"></RowDefinition>
                    <RowDefinition></RowDefinition>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition></ColumnDefinition>
                    <ColumnDefinition></ColumnDefinition>
                    <ColumnDefinition Width="auto"></ColumnDefinition>
                    <ColumnDefinition></ColumnDefinition>
                </Grid.ColumnDefinitions>
                <Label Grid.Row="0" Grid.Column="0" Margin="3">Training Data:</Label>
                <TextBox Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="3" Margin="3" Name="TxtTrainingData" VerticalAlignment="Center" HorizontalAlignment="Left" Width="100">No Data</TextBox>
                <Label Grid.Row="1" Grid.Column="0" Margin="3">Training Size:</Label>
                <TextBox Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="3" Margin="3" Name="TxtTrainingSize" VerticalAlignment="Center" HorizontalAlignment="Left" Width="70">0</TextBox>
                <Button Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="4" Margin="5,15" Width="80" IsEnabled="False" Name="BtnTrain" Click="BtnTrain_Click">TRAIN</Button>
                <Label Grid.Row="3" Grid.Column="0" Margin="3" HorizontalAlignment="Right" >Training Nr:</Label>
                <TextBox Grid.Row="3" Grid.Column="1" Margin="3" Name="TxtTrainNr" VerticalAlignment="Center" HorizontalAlignment="Left" Width="50">0</TextBox>
                <Label Grid.Row="3" Grid.Column="2">/</Label>
                <TextBox Grid.Row="3" Grid.Column="3" Margin="3" Name="TxtMaxTrainingSize" VerticalAlignment="Center" HorizontalAlignment="Left" Width="50">0</TextBox>
                <ProgressBar Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="4" Height="15" VerticalAlignment="Top" Margin="5" Name="PBTraining"></ProgressBar>
            </Grid>
        </GroupBox>
        <GroupBox Grid.Row="1" Grid.RowSpan="3" Grid.Column="1" Margin="5" Header="Test Neural Net:" BorderBrush="Blue" BorderThickness="1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="auto"></RowDefinition>
                    <RowDefinition Height="auto"></RowDefinition>
                    <RowDefinition Height="auto"></RowDefinition>
                    <RowDefinition Height="auto"></RowDefinition>
                    <RowDefinition Height="auto"></RowDefinition>
                    <RowDefinition Height="auto"></RowDefinition>
                    <RowDefinition></RowDefinition>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition></ColumnDefinition>
                    <ColumnDefinition></ColumnDefinition>
                </Grid.ColumnDefinitions>
                <Label Grid.Row="0" Grid.Column="0" Margin="3">Test Data:</Label>
                <TextBox Grid.Row="0" Grid.Column="1" Margin="3" Name="TxtTestData" HorizontalAlignment="Center" VerticalAlignment="Center" Width="90">No Data</TextBox>
                <Label Grid.Row="1" Grid.Column="0" Margin="3,8,3,3" HorizontalAlignment="Right">Sample Nr:</Label>
                <TextBox Grid.Row="1" Grid.Column="1" Margin="3,8,3,3" HorizontalAlignment="left" Width="50" Name="TxtSampleNr" VerticalAlignment="Center">0</TextBox>
                <Grid Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition></ColumnDefinition>
                        <ColumnDefinition></ColumnDefinition>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="auto"></RowDefinition>
                        <RowDefinition Height="auto"></RowDefinition>
                        <RowDefinition></RowDefinition>
                    </Grid.RowDefinitions>
                    <Border Grid.Row="0" Grid.RowSpan="3" Grid.Column="0" BorderBrush="Black" BorderThickness="1"  Margin="10" Width="86" Height="86">
                        <Canvas   Width="84" Height="84" Background="Beige" Name="CnvSample"></Canvas>
                    </Border>
                    <Label Grid.Row="0" Grid.Column="1" HorizontalAlignment="Center">TARGET :</Label>
                    <TextBox Grid.Row="1" Grid.Column="1" Name="txtTarget" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center" Width="40"></TextBox>
                </Grid>
                <Button Grid.Row="3" Grid.Column="0" Margin="5,5,5,10" Width="80" IsEnabled="False" Name="BtnNext" Click="BtnNext_Click" >NEXT</Button>
                <Button Grid.Row="3" Grid.Column="1" Margin="5,5,5,10" Width="80" IsEnabled="False" Name="BtnTest" Click="BtnTest_Click">TEST</Button>
                <Grid Grid.Row="4" Grid.Column="0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="auto"></RowDefinition>
                        <RowDefinition Height="auto"></RowDefinition>
                        <RowDefinition Height="auto"></RowDefinition>
                        <RowDefinition Height="auto"></RowDefinition>
                        <RowDefinition Height="auto"></RowDefinition>
                        <RowDefinition Height="auto"></RowDefinition>
                        <RowDefinition Height="auto"></RowDefinition>
                        <RowDefinition Height="auto"></RowDefinition>
                        <RowDefinition Height="auto"></RowDefinition>
                        <RowDefinition Height="auto"></RowDefinition>
                        <RowDefinition Height="auto"></RowDefinition>
                        <RowDefinition Height="auto"></RowDefinition>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition></ColumnDefinition>
                        <ColumnDefinition Width="2*"></ColumnDefinition>
                    </Grid.ColumnDefinitions>
                    <Label Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" HorizontalAlignment="Right"   Margin="3,0,15,0">OUTPUT:</Label>
                    <Label Grid.Row="1" Grid.Column="0" Margin="3,0" Height="20" Padding="5,0" HorizontalContentAlignment="Right">0:</Label>
                    <TextBox Grid.Row="1" Grid.Column="1" Margin="3,0" Height="20" Padding="5,0" Name="TxtOutput0">0</TextBox>
                    <Label Grid.Row="2" Grid.Column="0" Margin="3,0" Height="20" Padding="5,0" HorizontalContentAlignment="Right">1:</Label>
                    <TextBox Grid.Row="2" Grid.Column="1" Margin="3,0" Height="20" Padding="5,0" Name="TxtOutput1">0</TextBox>
                    <Label Grid.Row="3" Grid.Column="0" Margin="3,0" Height="20" Padding="5,0" HorizontalContentAlignment="Right">2:</Label>
                    <TextBox Grid.Row="3" Grid.Column="1" Margin="3,0" Height="20" Padding="5,0" Name="TxtOutput2">0</TextBox>
                    <Label Grid.Row="4" Grid.Column="0" Margin="3,0" Height="20" Padding="5,0" HorizontalContentAlignment="Right">3:</Label>
                    <TextBox Grid.Row="4" Grid.Column="1" Margin="3,0" Height="20" Padding="5,0" Name="TxtOutput3">0</TextBox>
                    <Label Grid.Row="5" Grid.Column="0" Margin="3,0" Height="20" Padding="5,0" HorizontalContentAlignment="Right">4:</Label>
                    <TextBox Grid.Row="5" Grid.Column="1" Margin="3,0" Height="20" Padding="5,0" Name="TxtOutput4">0</TextBox>
                    <Label Grid.Row="6" Grid.Column="0" Margin="3,0" Height="20" Padding="5,0" HorizontalContentAlignment="Right">5:</Label>
                    <TextBox Grid.Row="6" Grid.Column="1" Margin="3,0" Height="20" Padding="5,0" Name="TxtOutput5">0</TextBox>
                    <Label Grid.Row="7" Grid.Column="0" Margin="3,0" Height="20" Padding="5,0" HorizontalContentAlignment="Right">6:</Label>
                    <TextBox Grid.Row="7" Grid.Column="1" Margin="3,0" Height="20" Padding="5,0" Name="TxtOutput6">0</TextBox>
                    <Label Grid.Row="8" Grid.Column="0" Margin="3,0" Height="20" Padding="5,0" HorizontalContentAlignment="Right">7:</Label>
                    <TextBox Grid.Row="8" Grid.Column="1" Margin="3,0" Height="20" Padding="5,0" Name="TxtOutput7">0</TextBox>
                    <Label Grid.Row="9" Grid.Column="0" Margin="3,0" Height="20" Padding="5,0" HorizontalContentAlignment="Right">8:</Label>
                    <TextBox Grid.Row="9" Grid.Column="1" Margin="3,0" Height="20" Padding="5,0" Name="TxtOutput8">0</TextBox>
                    <Label Grid.Row="10" Grid.Column="0" Margin="3,0" Height="20" Padding="5,0" HorizontalContentAlignment="Right">9:</Label>
                    <TextBox Grid.Row="10" Grid.Column="1" Margin="3,0" Height="20" Padding="5,0" Name="TxtOutput9">0</TextBox>
                </Grid>
                <Grid Grid.Row="4" Grid.Column="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="auto"></RowDefinition>
                        <RowDefinition Height="auto"></RowDefinition>
                        <RowDefinition Height="auto"></RowDefinition>
                        <RowDefinition Height="auto"></RowDefinition>
                        <RowDefinition></RowDefinition>
                    </Grid.RowDefinitions>
                    <Label Grid.Row="0" Margin="10,0,10,10" HorizontalAlignment="Center">RESULT</Label>
                    <TextBox Grid.Row="1" Margin="10" FontSize="18" FontWeight="Bold" Width="50" HorizontalContentAlignment="Center" Name="txtResult">0</TextBox>
                    <Label Grid.Row="2" Margin="10,50,10,3" HorizontalAlignment="Center">OK %</Label>
                    <TextBox Grid.Row="3" Margin="10,3,10,10" FontSize="18" FontWeight="Bold" Width="80" HorizontalContentAlignment="Center" Name="txtPercentOK">0.00</TextBox>
                </Grid>
                <Button Grid.Row="5" Grid.Column="0" Grid.ColumnSpan="2" Margin="5,15,5,5" Width="80" IsEnabled="False" Name="BtnAll" Click="BtnAll_Click">TEST ALL</Button>
            </Grid>
        </GroupBox>
    </Grid>
</Window>

<Window x:Class="OpenTK_WPF.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:OpenTK_WPF"
        xmlns:TK="clr-namespace:OpenTK_WPF_Control"
        xmlns:glWpfControl="clr-namespace:OpenTK.Wpf;assembly=GLWpfControl"
        mc:Ignorable="d"
        Title="Shaders Test App" Height="800" Width="1200" Loaded="Window_Loaded"
        MouseDown="Window_MouseDown"  MouseMove="Window_MouseMove"  MouseUp="Window_MouseUp" 
        MouseWheel="Window_MouseWheel" Closing="Window_Closing"  WindowStartupLocation="CenterOwner">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="auto"></RowDefinition>
            <RowDefinition></RowDefinition>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*"></ColumnDefinition>
            <ColumnDefinition></ColumnDefinition>
        </Grid.ColumnDefinitions>
        <Menu Grid.Row="0" Grid.Column="0" FontSize="18" FontWeight="Bold">
            <MenuItem Header="File">
                <MenuItem Header="Load Fragment Shader" Name="mnuLoad" Click="mnuLoad_Click"></MenuItem>
                <Separator Margin="5"></Separator>
                <MenuItem Header="Save Fragment Shader" Name="mnuSave" Click="mnuSave_Click"></MenuItem>
                <MenuItem Header="Save Fragment Shader As" Name="mnuSaveAs" Click="mnuSaveAs_Click"></MenuItem>
                <Separator  Margin="5"></Separator>
                <MenuItem Header="Exit" Name="mnuExit" Click="mnuExit_Click"></MenuItem>
            </MenuItem>
            <MenuItem Header="Tools">
                <MenuItem Header="Load Texture" Name="mnuLoadTexture" Click="mnuLoadTexture_Click"></MenuItem>
                <Separator></Separator>
                <MenuItem Header="Load CubeMap" Name="mnuLoadCubeMap" Click="mnuLoadCubeMap_Click"></MenuItem>
                <MenuItem Header="Remove CubeMap" Name="mnuUnLoadCubeMap" Click="mnuUnLoadCubeMap_Click"></MenuItem>
                <Separator  Margin="5"></Separator>
                <MenuItem Header="Save Image" Name="mnuSaveImage" Click="mnuSaveImage_Click"></MenuItem>
            </MenuItem>
        </Menu>
        <glWpfControl:GLWpfControl Grid.Row="1" Grid.Column="0" x:Name="OpenTkControl">
            <glWpfControl:GLWpfControl.Settings>
                <glWpfControl:GLWpfControlSettings MajorVersion="3" MinorVersion="3"></glWpfControl:GLWpfControlSettings>
            </glWpfControl:GLWpfControl.Settings>
        </glWpfControl:GLWpfControl>
        <Label Grid.Row="0" Grid.Column="1" FontSize="18" FontWeight="Bold" Margin="20,0,0,0" Name="lblFileName"></Label>
        <Grid Grid.Row="1" Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition></RowDefinition>
                <RowDefinition Height="auto"></RowDefinition>
            </Grid.RowDefinitions>
            <Border  BorderBrush="Blue" BorderThickness="2.0" Margin="5">
                <ScrollViewer Grid.Row="0" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                    <TextBox Margin="5" FontFamily="Consolas"  FontSize="18" FontWeight="Bold" Name="txtShader" AcceptsReturn="True"></TextBox>
                </ScrollViewer>
            </Border>
            <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center">
                <Button  Width="80" Height="30" Margin="5" Name="btnPlay" Click="btnPlay_Click">
                    <Image Name="imgPlay" Source="/PauseIcon.jpg"></Image>
                </Button>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
